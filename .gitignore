# Python
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Run logs: the *_all.sh drivers and the SLURM jobs that write into a logs/ folder
logs/

# SLURM logs written next to their .slurm file (all 00 steps, submit_scran_norm.slurm,
# submit_smoke_test.slurm), plus the verify_integrity report of 00_3
*.out
*.err
/00_raw_data_processing/00_3_download/*.report

# Metadata Windows attaches to copied files, visible from WSL
*:Zone.Identifier

# Data: everything is excluded (tens of GB),
# except the small external inputs the code cannot regenerate
/datasets/*
!/datasets/README.md
!/datasets/Cells_Adult_Breast.pkl
!/datasets/regev_lab_cell_cycle_genes.txt
# The collaborator's gene lists scored in phase 03: every signature score depends on these exact files
!/datasets/signatures/
!/datasets/signatures/*.txt

# 02 smoke test outputs (fixtures, integrations, metrics), regenerated by the utils/ scripts
/02_integration_benchmark/utils/smoke_test/

# Trained DRVI models (temporary folder, ~1.3 GB of embeddings and weights)
/drvi/
